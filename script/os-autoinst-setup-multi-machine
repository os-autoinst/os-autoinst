#!/usr/bin/python3
# Copyright SUSE LLC
"""os-autoinst multi-machine setup script.

Configures networking for multi-machine testing with Open vSwitch.
"""

from __future__ import annotations

import os
import re
from pathlib import Path
from typing import Final

import sh
import typer
from sh import ErrorReturnCode
from tenacity import retry, retry_if_exception_type, stop_after_attempt, wait_fixed

app = typer.Typer()

# Default configuration values
DEFAULT_BRIDGE: Final = "br1"
DEFAULT_ETHERNET: Final = "br0"
DEFAULT_ZONE: Final = "trusted"
DEFAULT_MTU: Final = 1460
DEFAULT_NICOFFSET: Final = 64
DEFAULT_FIREWALL: Final = "nftables"


class SetupError(Exception):
    """Custom exception for setup errors."""


@retry(
    stop=stop_after_attempt(7),
    wait=wait_fixed(30),
    retry=retry_if_exception_type(SetupError),
    reraise=True,
)
def run_command(cmd: str, **kwargs: dict) -> str:
    """Execute a shell command with retries and error handling.

    Args:
        cmd: Command string to execute
        **kwargs: Additional arguments for sh

    Returns:
        Command output as string

    Raises:
        SetupError: If command fails
    """
    try:
        result = sh.bash("-c", cmd, **kwargs)
    except ErrorReturnCode as e:
        msg = f"Command failed: {cmd}\n{e.stderr.decode()}"
        raise SetupError(msg) from e
    else:
        return str(result).strip()


def ensure_ip_forwarding() -> None:
    """Enable IP forwarding for IPv4 and IPv6."""
    typer.echo("Ensuring IP forwarding is enabled...")

    try:
        with Path("/proc/sys/net/ipv4/ip_forward").open() as f:
            if f.read().strip() != "1":
                config_path = Path("/etc/sysctl.d/ip_forward.conf")
                config_content = (
                    "net.ipv4.ip_forward = 1\nnet.ipv6.conf.all.forwarding = 1\n"
                )
                config_path.write_text(config_content)
                typer.echo("IP forwarding configuration created")
    except OSError as e:
        msg = f"Failed to configure IP forwarding: {e}"
        raise SetupError(msg) from e


def install_packages(network: str) -> None:
    """Install required packages using zypper with retries."""
    typer.echo("Installing required packages...")

    packages = ["openvswitch", "os-autoinst-openvswitch", "firewalld", "libcap-progs"]
    if network == "NetworkManager":
        packages.append("NetworkManager-ovs")
    try:
        sh.rpm("-q", *packages)
    except ErrorReturnCode:
        typer.echo(f"Installing missing packages: {' '.join(packages)}")
        run_command(f"zypper ref && zypper -n in {' '.join(packages)}")
    typer.echo("Packages installed successfully")


def detect_instances() -> int:
    """Detect the number of openQA worker instances from systemd units."""
    output = run_command("systemctl 2> /dev/null || true")
    instances = len(re.findall(r"openqa-worker.*@\d+\.service", output))
    if instances < 1:
        typer.echo(
            'Unable to detect the number of instances; specify the number of instances manually via "--instances".',
            err=True,
        )
        raise typer.Exit(1)
    return instances


def _remove_existing_isotovideo_service() -> None:
    """Remove existing isotovideo firewall service if present."""
    try:
        services = sh.firewall_cmd("--permanent", "--get-services")
        if "isotovideo" in services:
            sh.firewall_cmd("--permanent", "--delete-service=isotovideo")
    except (ErrorReturnCode, SetupError):
        pass


def _set_firewall_default_zone(zone: str) -> None:
    """Set default firewall zone if needed."""
    sh.firewall_cmd("--get-default-zone") or sh.firewall_cmd("--set-default-zone", zone)


def configure_firewall(instances: int, zone: str) -> None:
    """Configure firewall rules for isotovideo."""
    typer.echo("Configuring firewall...")

    try:
        sh.systemctl("enable", "--now", "firewalld")
        _remove_existing_isotovideo_service()

        sh.firewall_cmd("--permanent", "--new-service", "isotovideo")

        for i in range(1, instances + 1):
            port = i * 10 + 20003
            sh.firewall_cmd(
                "--permanent",
                "--service=isotovideo",
                f"--add-port={port}/tcp",
            )

        sh.firewall_cmd("--permanent", f"--zone={zone}", "--add-service=isotovideo")
        _set_firewall_default_zone(zone)
        sh.firewall_cmd("--reload")

        typer.echo("Firewall configured successfully")
    except ErrorReturnCode as e:
        msg = f"Failed to configure firewall: {e}"
        raise SetupError(msg) from e


def _disable_firewalld_if_installed() -> None:
    """Disable firewalld if it's installed."""
    try:
        sh.rpm("-q", "firewalld")
        sh.systemctl("disable", "--now", "firewalld")
    except ErrorReturnCode:
        pass


def _create_nftables_service() -> None:
    """Create nftables systemd service."""
    service_content = """[Unit]
Description=Apply firewall rules from /etc/firewall.nft
After=network-online.target
Wants=network-online.target
Conflicts=firewalld.service

[Install]
WantedBy=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/usr/sbin/nft -f /etc/firewall.nft
ExecStop=/usr/sbin/nft flush ruleset
"""
    Path("/etc/systemd/system/nftables.service").write_text(service_content)


def _create_nftables_rules(ethernet: str, bridge: str) -> None:
    """Create nftables rules file."""
    rules_content = f"""#!/usr/sbin/nft -f

# dump with "nft --stateless list ruleset"

flush ruleset

table ip nat {{
    chain postrouting {{
        type nat hook postrouting priority 100; policy accept;
        oifname "{ethernet}" masquerade
        oifname "{bridge}" masquerade
        oifname "ovs-system" masquerade
    }}
}}
"""
    Path("/etc/firewall.nft").write_text(rules_content)


def configure_nftables(ethernet: str, bridge: str) -> None:
    """Configure nftables as alternative to firewalld."""
    typer.echo("Configuring nftables...")
    _disable_firewalld_if_installed()
    _create_nftables_service()
    _create_nftables_rules(ethernet, bridge)
    sh.systemctl("daemon-reload")
    sh.systemctl("enable", "--now", "nftables")
    typer.echo("nftables configured successfully")


def create_gre_preup_script(location: str, bridge: str) -> None:
    """Create GRE tunnel pre-up script."""
    script_path = Path(location)
    if script_path.is_file():
        typer.echo(f"Dispatcher script {location} already exists, keeping existing configuration.")
        script_path.chmod(0o755)
        return
    script_content = f"""#!/bin/sh
# This file can be used to automatically setup a GRE tunnel to another multi-machine test host
# Further information available at https://github.com/os-autoinst/os-autoinst/blob/master/doc/networking.md

OVS_CMD=$(command -v ovs-vsctl)
if [ -z "$OVS_CMD" ]; then
    logger -- "Error: ovs-vsctl not found. Skipping script $0"
    exit 0 # Exit 0 to avoid breaking NetworkManager's flow
fi

# NM_DISPATCHER_ACTION env var is set when NM calls scripts via dispatcher service
# Ref: https://networkmanager.dev/docs/api/1.44.4/NetworkManager-dispatcher.html
# 2. Argument Normalization (NetworkManager vs. wicked)
# NetworkManager: $1 = interface name, $2 = action
# wicked: $1 = action, $2 = interface name
if [ -n "$NM_DISPATCHER_ACTION" ]; then
    # Environment detected as NetworkManager
    bridge_to_check="$1"
    action="$2"
else
    # Environment detected as wicked (or manual call)
    action="$1"
    bridge_to_check="$2"
fi

# use grep -qx to ensure the bridge exists in the OVS database if more than one ovs bridge are in db
if "$OVS_CMD" list-br | grep -qx "$bridge_to_check"; then
    if [ "$action" = "pre-up" ] || [ "$action" = "up" ]; then
        ovs-vsctl set bridge "$bridge_to_check" rstp_enable=true
        # TODO add entries according to your network topology
        #ovs-vsctl --may-exist add-port "$bridge_to_check" gre1 -- set interface gre1 type=gre options:remote_ip=<IP address of other host>
    fi

fi
"""
    script_path = Path(location)
    script_path.parent.mkdir(parents=True, exist_ok=True)
    script_path.write_text(script_content)
    script_path.chmod(0o755)


def _parse_default_interface(output: str) -> str | None:
    """Parse default interface from ip route output."""
    parts = output.split()
    if "dev" in parts:
        idx = parts.index("dev")
        if idx + 1 < len(parts):
            return parts[idx + 1]
    return None


def _try_common_interfaces() -> str | None:
    """Try to find a common interface that exists."""
    common_interfaces = ["eth0", "enp0s3", "ens3", "br0"]
    for iface in common_interfaces:
        try:
            sh.ip("link", "show", iface)
        except ErrorReturnCode:
            continue
        else:
            typer.echo(f"Using fallback interface: {iface}")
            return iface
    return None


def determine_ethernet() -> str:
    """Automatically determine default ethernet device or bridge."""
    typer.echo("Determining default ethernet interface...")

    try:
        output = sh.ip("route", "show", "default")
        if output:
            interface = _parse_default_interface(output)
            if interface:
                typer.echo(f"Auto-detected ethernet interface: {interface}")
                return interface
    except ErrorReturnCode:
        pass

    interface = _try_common_interfaces()
    if interface:
        return interface

    typer.echo(
        "Warning: Could not determine ethernet interface, using default 'br0'",
        err=True,
    )
    return "br0"


def _previous_connection_matches(conn_type: str, device: str, name: str, uuid: str) -> bool:
    """Return whether a NetworkManager connection belongs to multi-machine setup."""
    if re.match(r"ovs-(?:bridge|port|interface|slave)", conn_type) or re.match(r"ovs-(?:bridge|port|interface|slave)", name):
        return True
    if conn_type != "tun":
        return False
    if re.match(r"tap[0-9]+$", device) or re.match(r"tun(-tap[0-9]+)?$", name) or re.match(r"tun-[0-9]+$", name):
        return True
    interface = str(sh.nmcli("-g", "connection.interface-name", "con", "show", uuid, _ok_code=[0, 1])).strip()
    return bool(re.match(r"tap[0-9]+$", interface))


def _cleanup_networkmanager_connections() -> None:
    """Delete previous NetworkManager connections created for multi-machine testing."""
    try:
        output = str(sh.nmcli("-g", "UUID,TYPE,DEVICE,NAME", "con", "show", _ok_code=[0, 1]))
    except ErrorReturnCode:
        return
    stale = []
    for line in output.splitlines():
        fields = line.split(":", 3)
        if len(fields) != 4:
            continue
        uuid, conn_type, device, name = fields
        if _previous_connection_matches(conn_type, device, name, uuid):
            stale.append(uuid)
    if stale:
        typer.echo(f"Deleting {len(stale)} previous NetworkManager connections...")
        sh.nmcli("con", "del", *stale, _ok_code=[0, 1])


def _cleanup_ovs_bridge(bridge: str) -> None:
    """Start openvswitch and delete the bridge from the OVS database."""
    sh.systemctl("start", "openvswitch")
    sh.ovs_vsctl("--if-exists", "del-br", bridge)


def _get_worker_uid() -> str:
    """Get _openqa-worker user ID."""
    return sh.id("-u", "_openqa-worker").strip()


def _get_nogroup_gid() -> str:
    """Get nogroup GID."""
    return sh.getent("group", "nogroup").split(":")[2]


def _tap_dev_numbers(instances: int, nicoffset: int) -> list[int]:
    """Compute tap device numbers: 0, 1..instances, and two nicoffset groups."""
    return (
        [0]
        + list(range(1, instances + 1))
        + list(range(nicoffset, nicoffset + instances + 1))
        + list(range(2 * nicoffset, 2 * nicoffset + instances + 1))
    )


def setup_multi_machine_with_networkmanager(
    instances: int,
    bridge: str,
    zone: str,
    mtu: int,
    nicoffset: int,
) -> None:
    """Setup multi-machine networking using NetworkManager."""
    typer.echo("Setting up multi-machine with NetworkManager...")

    try:
        _cleanup_networkmanager_connections()
        _cleanup_ovs_bridge(bridge)

        # Clear NM state and timestamps
        sh.systemctl("stop", "NetworkManager")
        nm_lib_dir = Path("/var/lib/NetworkManager")
        if nm_lib_dir.is_dir():
            for f in ["timestamps", "NetworkManager.state"]:
                (nm_lib_dir / f).unlink(missing_ok=True)
        sh.systemctl("start", "NetworkManager")

        sh.nmcli("con", "add", "type", "ovs-bridge", "con-name", f"ovs-bridge-{bridge}",
                 "con.interface", bridge, "ipv4.dad-timeout", "0")
        sh.nmcli("con", "add", "type", "ovs-port", "con-name", f"ovs-port-{bridge}",
                 "con.interface", bridge, "con.master", bridge)
        sh.nmcli(
            "con",
            "add",
            "type",
            "ovs-interface",
            "con-name",
            f"ovs-interface-{bridge}",
            "con.interface",
            bridge,
            "con.master",
            bridge,
            "ipv4.method",
            "manual",
            "ipv4.address",
            "10.0.2.2/15",
            "ipv4.dad-timeout",
            "0",
            "ipv6.method",
            "manual",
            "ipv6.address",
            "fec0::2/63",
            "ipv6.dad-timeout",
            "0",
            "ethernet.mtu",
            str(mtu),
            "connection.zone",
            zone,
        )

        worker_uid = _get_worker_uid()
        nogroup_gid = _get_nogroup_gid()

        for i in _tap_dev_numbers(instances, nicoffset):
            tap_name = f"tap{i}"
            sh.nmcli(
                "con",
                "add",
                "type",
                "ovs-port",
                "con-name",
                f"ovs-port-{tap_name}",
                "con.interface",
                tap_name,
                "con.master",
                bridge,
            )
            sh.nmcli(
                "con",
                "add",
                "type",
                "tun",
                "con-name",
                tap_name,
                "mode",
                "tap",
                "owner",
                worker_uid,
                "group",
                nogroup_gid,
                "con.interface",
                tap_name,
                "master",
                tap_name,
                "connection.autoconnect",
                "yes",
            )

        create_gre_preup_script("/etc/NetworkManager/dispatcher.d/gre_tunnel_preup.sh", bridge)
        sh.nmcli("con", "up", f"ovs-bridge-{bridge}")
        sh.nmcli("con", "up", f"ovs-interface-{bridge}")
        typer.echo("NetworkManager configuration completed")
    except ErrorReturnCode as e:
        msg = f"Failed to setup NetworkManager: {e}"
        raise SetupError(msg) from e


def _create_bridge_config(instances: int, bridge: str, mtu: int, nicoffset: int) -> str:
    """Create bridge configuration content."""
    config = f"""STARTMODE='auto'
BOOTPROTO='static'
IPADDR='10.0.2.2/15'
OVS_BRIDGE='yes'
OVS_BRIDGE_PORT_DEVICE='tap0'
MTU='{mtu}'
"""
    for i in _tap_dev_numbers(instances, nicoffset):
        config += f"OVS_BRIDGE_PORT_DEVICE_{i}='tap{i}'\n"
    return config


def _create_tap0_config() -> str:
    """Create tap0 configuration content."""
    config = """STARTMODE='auto'
BOOTPROTO='none'
TUNNEL='tap'
TUNNEL_SET_OWNER='_openqa-worker'
"""
    nogroup_gid = _get_nogroup_gid()
    config += f"TUNNEL_SET_GROUP='{nogroup_gid}'\n"
    return config


def _create_tap_symlinks(network_dir: Path, instances: int, nicoffset: int) -> None:
    """Create symlinks for tap devices."""
    for i in _tap_dev_numbers(instances, nicoffset):
        if i == 0:
            continue
        tap_file = network_dir / f"ifcfg-tap{i}"
        if tap_file.exists():
            tap_file.unlink()
        tap_file.symlink_to("ifcfg-tap0")


def setup_multi_machine_with_wicked(
    instances: int,
    bridge: str,
    mtu: int,
    nicoffset: int,
) -> None:
    """Setup multi-machine networking using wicked."""
    typer.echo("Setting up multi-machine with wicked...")

    _cleanup_ovs_bridge(bridge)
    sh.ovs_vsctl("add-br", bridge)
    sh.ovs_vsctl("set", "int", bridge, f"mtu_request={mtu}")

    network_dir = Path("/etc/sysconfig/network")

    bridge_config = _create_bridge_config(instances, bridge, mtu, nicoffset)
    bridge_file = network_dir / f"ifcfg-{bridge}"
    bridge_file.write_text(bridge_config)

    tap0_config = _create_tap0_config()
    tap0_file = network_dir / "ifcfg-tap0"
    tap0_file.write_text(tap0_config)

    _create_tap_symlinks(network_dir, instances, nicoffset)
    create_gre_preup_script("/etc/wicked/scripts/gre_tunnel_preup.sh", bridge)

    typer.echo("Wicked configuration completed")


def configure_openvswitch(bridge: str) -> None:
    """Configure Open vSwitch and restart services."""
    typer.echo("Configuring Open vSwitch...")

    try:
        sh.setcap("CAP_NET_ADMIN=ep", "/usr/lib/os-autoinst/os-autoinst-openvswitch")
        sh.ovs_vsctl("--may-exist", "add-br", bridge)
        sh.ovs_vsctl(
            "set",
            "bridge",
            bridge,
            "other-config:hwaddr=52:54:00:12:34:56",
        )
        sh.systemctl("restart", "openvswitch", "os-autoinst-openvswitch")
        typer.echo("Open vSwitch configured successfully")
    except ErrorReturnCode as e:
        msg = f"Failed to configure Open vSwitch: {e}"
        raise SetupError(msg) from e


def _detect_from_systemd_link() -> str | None:
    """Detect network manager from systemd service link."""
    try:
        service_link = Path("/etc/systemd/system/network.service").readlink()
        service_name = service_link.name.replace(".service", "")
        if service_name in {"wicked", "NetworkManager"}:
            return service_name
    except OSError:
        pass
    return None


def _detect_from_running_services() -> str | None:
    """Detect network manager from running services."""
    for manager in ("NetworkManager", "wicked"):
        try:
            if sh.systemctl("is-active", manager).strip() == "active":
                return manager
        except ErrorReturnCode:
            continue
    return None


def detect_network_manager() -> str | None:
    """Detect which network manager is in use."""
    manager = _detect_from_systemd_link()
    if manager:
        return manager
    return _detect_from_running_services()


def _print_completion_summary(
    bridge: str,
    ethernet: str,
    instances: int,
    zone: str,
    mtu: int,
) -> None:
    """Print setup completion summary."""
    typer.echo("\n✓ Multi-machine setup completed successfully!")
    typer.echo(f"  Bridge: {bridge}")
    typer.echo(f"  Ethernet: {ethernet}")
    typer.echo(f"  Instances: {instances}")
    typer.echo(f"  Zone: {zone}")
    typer.echo(f"  MTU: {mtu}")


def _check_root() -> None:
    """Check if running as root."""
    if os.geteuid() != 0:
        typer.echo("Error: This script must be run as root", err=True)
        raise typer.Exit(1)


def _validate_network_manager(network: str | None) -> str:
    """Validate network manager is supported."""
    if not network:
        typer.echo(
            "Error: This script only works with wicked or NetworkManager",
            err=True,
        )
        raise typer.Exit(1)
    typer.echo(f"Detected network manager: {network}")
    return network


def _setup_firewall(firewall: str, ethernet: str, bridge: str, instances: int, zone: str) -> None:
    """Setup firewall configuration for the chosen backend."""
    if firewall == "firewalld":
        configure_firewall(instances, zone)
    else:
        configure_nftables(ethernet, bridge)


def _setup_network_specific(network: str, instances: int, bridge: str, mtu: int, zone: str, nicoffset: int) -> None:
    """Setup network-specific configuration."""
    if network == "wicked":
        setup_multi_machine_with_wicked(instances, bridge, mtu, nicoffset)
    elif network == "NetworkManager":
        setup_multi_machine_with_networkmanager(instances, bridge, zone, mtu, nicoffset)


def delete_tap_ifaces() -> None:
    """Delete existing tap interfaces."""
    typer.echo("Deleting existing tap interfaces...")
    net_path = Path("/sys/class/net")
    if not net_path.exists():
        return
    for iface in net_path.glob("tap*"):
        if (iface / "tun_flags").exists():
            sh.ip("link", "delete", iface.name, _ok_code=[0, 1])


def cleanup_openvswitch_db() -> None:
    """Clean up Open vSwitch database."""
    typer.echo("Cleaning up Open vSwitch database...")
    sh.systemctl("stop", "openvswitch", "os-autoinst-openvswitch", _ok_code=[0, 1])
    ovs_lib_dir = Path("/var/lib/openvswitch")
    if ovs_lib_dir.is_dir():
        for f in ["conf.db", ".conf.db.~lock~"]:
            (ovs_lib_dir / f).unlink(missing_ok=True)


@app.command()
def main(
    instances: int | None = typer.Option(
        None,
        "--instances",
        "-i",
        help="number of worker instances to configure (auto-detected if omitted)",
        envvar="instances",
    ),
    bridge: str = typer.Option(
        DEFAULT_BRIDGE,
        "--bridge",
        "-b",
        help="Bridge interface name",
        envvar="bridge",
    ),
    ethernet: str | None = typer.Option(
        None,
        "--ethernet",
        "-e",
        help="Ethernet interface name (auto-detected if not specified)",
        envvar="ethernet",
    ),
    zone: str = typer.Option(
        DEFAULT_ZONE,
        "--zone",
        "-z",
        help="Firewall zone",
        envvar="zone",
    ),
    mtu: int = typer.Option(
        DEFAULT_MTU,
        "--mtu",
        "-m",
        help="MTU for bridge interface. Set the MTU of the bridge interface according to https://docs.openvswitch.org/en/latest/faq/issues. See https://progress.opensuse.org/issues/151310. Default is 1460 instead of 1450 as the FAQ suggests) because 1460 should be low enough but is still higher than 1458 which openSUSE MM tests configure within the SUT.",
        envvar="mtu",
    ),
    firewall: str = typer.Option(
        DEFAULT_FIREWALL,
        "--firewall",
        "-f",
        help="firewall backend: nftables or firewalld",
        envvar="firewall",
    ),
    nicoffset: int = typer.Option(
        DEFAULT_NICOFFSET,
        "--nic-offset",
        "-o",
        help="offset for NIC devices (OS_AUTOINST_NICOFFSET)",
        envvar="OS_AUTOINST_NICOFFSET",
    ),
) -> None:
    """Setup multi-machine testing infrastructure for os-autoinst.

    This script configures Open vSwitch networking, firewall rules,
    and tap devices for multi-machine testing scenarios.
    """
    _check_root()

    try:
        if instances is None:
            instances = detect_instances()
            typer.echo(f"Auto-detected {instances} worker instances")
        else:
            typer.echo(f"Assuming {instances} worker instances as specified")
        if instances >= nicoffset:
            typer.echo("The NIC offset must be greater than the number of instances.", err=True)
            raise typer.Exit(2)

        network = detect_network_manager()
        network = _validate_network_manager(network)

        if ethernet is None:
            ethernet = determine_ethernet()

        ensure_ip_forwarding()
        install_packages(network)
        _setup_firewall(firewall, ethernet, bridge, instances, zone)

        cleanup_openvswitch_db()
        delete_tap_ifaces()

        sh.systemctl("enable", "--now", "openvswitch", "os-autoinst-openvswitch")
        _setup_network_specific(network, instances, bridge, mtu, zone, nicoffset)
        
        # Ensure sysconfig is set for os-autoinst-openvswitch
        sysconfig_path = Path("/etc/sysconfig/os-autoinst-openvswitch")
        sysconfig_path.write_text(f"OS_AUTOINST_USE_BRIDGE={bridge}\n")
        
        configure_openvswitch(bridge)

        _print_completion_summary(bridge, ethernet, instances, zone, mtu)

    except SetupError as e:
        typer.echo(f"Setup failed: {e}", err=True)
        raise typer.Exit(1) from e
    except KeyboardInterrupt:
        typer.echo("\nSetup interrupted by user", err=True)
        raise typer.Exit(130) from None


if __name__ == "__main__":
    app()
